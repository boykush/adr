adr "0004" "Choose the home for secrets shared across repositories"

# 跨いで使う秘密は composite action の出力から受け取る。どの名前で repo secret に
# 置かれていたかは移行とともに消えるので、Claude Code Action の入力の側から見る。
# 認証の入力を secrets へ直接つないでいないこと、それだけを assertion にする。
path "Workflows"     = ".github/workflows/*.yml"
path "WorkflowsYaml" = ".github/workflows/*.yaml"

file "claude_token_via_composite_action" {
  Workflows must not contain "regex:(claude_code_oauth_token|anthropic_api_key):\\s*\\$\\{\\{\\s*secrets\\."
  WorkflowsYaml must not contain "regex:(claude_code_oauth_token|anthropic_api_key):\\s*\\$\\{\\{\\s*secrets\\."
  severity error
}
