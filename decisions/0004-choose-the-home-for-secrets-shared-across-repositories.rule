adr "0004" "Choose the home for secrets shared across repositories"

# 跨いで使う秘密を repo secret として参照している箇所。organization secret が
# 無いので、ここに書かれた分だけ長命な秘密が GitHub 側に増え、入れ替えが
# リポジトリの数だけ要る。読み出しは composite action に寄せる。
path "Workflows"     = ".github/workflows/*.yml"
path "WorkflowsYaml" = ".github/workflows/*.yaml"

# secrets. を含めて照合する。composite action に渡す入力名は小文字の
# claude_code_oauth_token で、そちらは秘密の在処ではないので巻き込まない。
file "shared_secrets_not_in_repo" {
  Workflows must not contain "secrets.CLAUDE_CODE_OAUTH_TOKEN"
  Workflows must not contain "secrets.ANTHROPIC_API_KEY"
  WorkflowsYaml must not contain "secrets.CLAUDE_CODE_OAUTH_TOKEN"
  WorkflowsYaml must not contain "secrets.ANTHROPIC_API_KEY"
  severity error
}
